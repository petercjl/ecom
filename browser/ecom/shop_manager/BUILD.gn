action("resources") {
  script = "embed_resources.py"
  inputs = [
    "index.html",
    "manager.css",
    "manager.js",
    "model.js",
    "memory.html",
    "memory.js",
    "memory.css",
  ]
  inputs += [ "//brave/node_modules/@brave/leo/icons/container-personal.svg" ]
  inputs += [ "//brave/node_modules/@brave/leo/icons/container-work.svg" ]
  inputs += [ "//brave/node_modules/@brave/leo/icons/container-shopping.svg" ]
  inputs += [ "//brave/node_modules/@brave/leo/icons/container-social.svg" ]
  inputs += [ "//brave/node_modules/@brave/leo/icons/container-events.svg" ]
  inputs += [ "//brave/node_modules/@brave/leo/icons/container-banking.svg" ]
  inputs += [ "//brave/node_modules/@brave/leo/icons/container-star.svg" ]
  inputs += [ "//brave/node_modules/@brave/leo/icons/container-travel.svg" ]
  inputs += [ "//brave/node_modules/@brave/leo/icons/container-school.svg" ]
  inputs += [ "//brave/node_modules/@brave/leo/icons/container-private.svg" ]
  inputs += [ "//brave/node_modules/@brave/leo/icons/container-messaging.svg" ]
  outputs = [ "$target_gen_dir/shop_manager_resources.h" ]
  args = [
    "--output",
    rebase_path(outputs[0], root_build_dir),
    "--source",
    rebase_path(".", root_build_dir),
  ]
}

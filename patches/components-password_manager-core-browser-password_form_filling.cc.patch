diff --git a/components/password_manager/core/browser/password_form_filling.cc b/components/password_manager/core/browser/password_form_filling.cc
--- a/components/password_manager/core/browser/password_form_filling.cc
+++ b/components/password_manager/core/browser/password_form_filling.cc
@@ -276,8 +276,21 @@
         wait_for_username_reason);
   }
 
-  bool wait_for_username =
-      wait_for_username_reason != WaitForUsernameReason::kDontWait;
+  const auto& frame_origin = driver->GetLastCommittedOrigin();
+  const bool configured_login =
+      preferred_match && GetMatchType(*preferred_match) == GetLoginMatchType::kExact &&
+      IsSameOrigin(frame_origin, preferred_match->url) &&
+      observed_form.HasUsernameElement() && observed_form.HasPasswordElement() &&
+      !observed_form.HasNonEmptyPasswordValue() &&
+      !observed_form.accepts_webauthn_credentials &&
+      !client->IsActorTaskActive() && !client->IsPasswordChangeOngoing() &&
+      client->IsCommittedMainFrameSecure() &&
+      client->CanAutofillConfiguredContainerLogin(frame_origin);
+  const bool wait_for_username =
+      !configured_login ||
+      (wait_for_username_reason != WaitForUsernameReason::kDontWait &&
+       wait_for_username_reason != WaitForUsernameReason::kCrossOriginIframe &&
+       wait_for_username_reason != WaitForUsernameReason::kFoasFeature);
 #else
   bool wait_for_username = true;
 #endif  // !BUILDFLAG(IS_IOS) && !defined(ANDROID)

{
  "schemaVersion": 1,
  "package": "@petercjl/ecom-cli",
  "version": "0.2.1",
  "skills": [
    "ecom-cli"
  ],
  "commandContracts": {
    "help": {
      "options": {
        "--json": {
          "type": "boolean"
        }
      },
      "sideEffects": "none"
    },
    "version": {
      "options": {
        "--json": {
          "type": "boolean"
        }
      },
      "sideEffects": "none"
    },
    "capabilities": {
      "options": {
        "--json": {
          "type": "boolean"
        }
      },
      "sideEffects": "none"
    },
    "schema": {
      "options": {
        "--json": {
          "type": "boolean"
        }
      },
      "sideEffects": "none"
    },
    "doctor": {
      "options": {
        "--json": {
          "type": "boolean"
        },
        "--profile": {
          "type": "string"
        },
        "--instance": {
          "type": "string"
        }
      },
      "sideEffects": "none"
    },
    "containers list": {
      "options": {
        "--json": {
          "type": "boolean"
        },
        "--profile": {
          "type": "string"
        },
        "--instance": {
          "type": "string"
        }
      },
      "sideEffects": "local-write",
      "authorization": "Read container IDs and names; authenticated local request and throttled update cache only"
    },
    "skill source": {
      "options": {
        "--json": {
          "type": "boolean"
        },
        "--name": {
          "type": "string"
        }
      },
      "sideEffects": "none"
    },
    "skill status": {
      "options": {
        "--json": {
          "type": "boolean"
        },
        "--agent": {
          "type": "string"
        },
        "--target": {
          "type": "string"
        },
        "--name": {
          "type": "string"
        }
      },
      "sideEffects": "none"
    },
    "skill install": {
      "options": {
        "--json": {
          "type": "boolean"
        },
        "--agent": {
          "type": "string"
        },
        "--target": {
          "type": "string"
        },
        "--name": {
          "type": "string"
        }
      },
      "sideEffects": "local-write"
    },
    "skill update": {
      "options": {
        "--json": {
          "type": "boolean"
        },
        "--agent": {
          "type": "string"
        },
        "--target": {
          "type": "string"
        },
        "--name": {
          "type": "string"
        }
      },
      "sideEffects": "local-write"
    },
    "update check": {
      "options": {
        "--json": {
          "type": "boolean"
        }
      },
      "sideEffects": "none"
    },
    "update install": {
      "options": {
        "--json": {
          "type": "boolean"
        },
        "--agent": {
          "type": "string"
        },
        "--target": {
          "type": "string"
        },
        "--name": {
          "type": "string"
        },
        "--version": {
          "type": "string"
        },
        "--yes": {
          "type": "boolean"
        }
      },
      "sideEffects": "package-and-skill-update"
    },
    "containers inspect": {
      "options": {
        "--json": {
          "type": "boolean"
        },
        "--profile": {
          "type": "string"
        },
        "--instance": {
          "type": "string"
        },
        "--container": {
          "type": "string",
          "required": true,
          "description": "Stable container ID or unique exact name"
        }
      },
      "sideEffects": "local-write",
      "authorization": "Read selected account metadata; credentials excluded and homepage credential fields redacted. Automatic update detection only.",
      "output": {
        "container": "id, name, platform, platformName, homeUrl, icon, color, login",
        "login": "state, service, authenticationState, verificationSupported, checking, checkedAt, identityBound, identityConfirmed, expiry"
      },
      "errors": [
        "CONTAINER_NOT_FOUND",
        "CONTAINER_AMBIGUOUS",
        "PROTOCOL_MISMATCH"
      ]
    },
    "session request": {
      "options": {
        "--json": {
          "type": "boolean"
        },
        "--profile": {
          "type": "string"
        },
        "--instance": {
          "type": "string"
        },
        "--container": {
          "type": "string",
          "required": true,
          "description": "Stable container ID or unique exact name"
        },
        "--url": {
          "type": "string",
          "required": true,
          "description": "HTTPS URL in the origin explicitly enabled by Ecom; no credentials or fragment"
        },
        "--method": {
          "type": "string",
          "default": "GET",
          "enum": [
            "GET"
          ]
        }
      },
      "sideEffects": "local-write",
      "authorization": "Explicit user-authorized read operation using selected persistent container; website credentials remain native. GET is a transport restriction, not proof of business read-only semantics.",
      "output": {
        "instance": "Pinned Ecom identity",
        "container": "id and name",
        "httpStatus": "200",
        "data": "Native-redacted JSON response",
        "businessStatus": "not-evaluated"
      },
      "limits": {
        "clientTimeoutMs": 60000,
        "nativeNetworkTimeoutMs": 20000,
        "nativeResponseBytes": 2097152,
        "redirects": "rejected",
        "html": "rejected",
        "concurrency": "native limit 2 requests"
      },
      "errors": [
        "INVALID_URL",
        "METHOD_UNSUPPORTED",
        "CREDENTIAL_INPUT_REJECTED",
        "ORIGIN_NOT_ALLOWED",
        "CONTAINER_NOT_FOUND",
        "CONTAINER_AMBIGUOUS",
        "SHOP_NOT_READY",
        "SHOP_VERIFICATION_FAILED",
        "BUSY",
        "REQUEST_FAILED",
        "NON_JSON_RESPONSE",
        "INSTANCE_CHANGED",
        "PROTOCOL_MISMATCH",
        "OPERATION_TIMEOUT"
      ]
    }
  },
  "transport": {
    "kind": "private-local-mailbox",
    "protocolVersion": 1,
    "debuggingRequired": false,
    "platforms": {
      "macos": "implemented",
      "windows": "unsupported"
    }
  },
  "discoveryContract": {
    "schemaVersion": 1,
    "commandsField": "commandContracts",
    "entryPoints": [
      {
        "argv": [
          "capabilities",
          "--json"
        ],
        "result": "manifest"
      }
    ],
    "version": {
      "command": "version",
      "argv": [
        "version",
        "--json"
      ],
      "fields": {
        "package": {
          "field": "package",
          "type": "string"
        },
        "version": {
          "field": "version",
          "type": "string"
        }
      }
    },
    "skillCollection": {
      "namesField": "skills",
      "default": "ecom-cli",
      "selector": {
        "option": "--name",
        "type": "string"
      },
      "enumeration": {
        "argv": [
          "skill",
          "source",
          "--json"
        ],
        "itemsField": "items",
        "completeField": "complete"
      },
      "namedSource": [
        "skill",
        "source",
        "--name",
        "{skill}",
        "--json"
      ]
    }
  },
  "maintenanceContract": {
    "schemaVersion": 1,
    "agentEligibility": "valid-name-with-generic-fallback",
    "hostDiscoveryAuthority": "host",
    "targetOptions": {
      "--target": {
        "kind": "skill-directory"
      }
    },
    "source": {
      "name": {
        "field": "name",
        "type": "string"
      },
      "package": {
        "field": "package",
        "type": "string"
      },
      "version": {
        "field": "version",
        "type": "string"
      },
      "path": {
        "field": "path",
        "type": "string"
      }
    },
    "status": {
      "name": {
        "field": "name",
        "type": "string"
      },
      "package": {
        "field": "package",
        "type": "string"
      },
      "version": {
        "field": "version",
        "type": "string"
      },
      "target": {
        "field": "target",
        "type": "string"
      },
      "installed": {
        "field": "installed",
        "type": "boolean"
      },
      "managed": {
        "field": "managed",
        "type": "boolean"
      },
      "current": {
        "field": "current",
        "type": "boolean"
      },
      "edited": {
        "field": "edited",
        "type": "boolean"
      },
      "verification": {
        "field": "verification",
        "type": "object"
      },
      "recovery": {
        "field": "recovery",
        "type": "object"
      }
    }
  },
  "installationLifecycle": {
    "skillRequired": true,
    "updateRequiresSkillSync": true,
    "required_components": [
      "cli",
      "skill"
    ],
    "agentNeutral": true,
    "targetRequired": true,
    "hostRegistrationRequired": true,
    "installationMode": "copy",
    "sharedLinksAllowed": false,
    "isolatedRuntimeRequired": true,
    "installGuide": "INSTALL.md",
    "updateGuide": "UPDATE.md",
    "install": "Resolve current Agent exact Skill target; run skill install --agent NAME --target PATH; load Skill through host discovery.",
    "update": "Run selected Skill runtime update install --agent NAME --target PATH --yes; verify returned activated entry and refresh host discovery.",
    "verification": "Verify CLI and Skill versions, managed hashes, current=true and recovery.required=false; host loads installed SKILL.md independently."
  },
  "automaticUpdates": {
    "enabledByDefault": true,
    "intervalHours": 24,
    "timeoutMs": 1500,
    "trigger": "containers list, containers inspect and session request task entry",
    "configuration": "Stable latest channel; detection only. Explicit update activates only the selected target runtime and Skill together.",
    "disable": "ECOM_CLI_UPDATE_CHECK=0",
    "recovery": "Offline checks retain installed runtime; local edit/ownership conflicts stop replacement; prior target kept as backup. Use recorded candidate and inspect target status before retrying.",
    "defaultMode": "notify"
  },
  "compatibility": {
    "agents": "Any Agent with terminal, Node.js and Skill discovery capabilities; generic adapter",
    "macos": "Native container list, account inspection and authorized session GET verified on macOS arm64 Ecom Dev; host discovery is checked separately",
    "windows": "Package mechanics only; browser transport unsupported",
    "historicalUpdater": "Actual published 0.1.1, 0.1.2, 0.1.3 and 0.2.0 updater entries verified with real npm, preserved prior versions, isolated targets and failure recovery"
  },
  "errors": [
    "INSTANCE_NOT_RUNNING",
    "INSTANCE_AMBIGUOUS",
    "INSTANCE_CHANGED",
    "UNSAFE_ENDPOINT",
    "OPERATION_TIMEOUT",
    "PROTOCOL_MISMATCH",
    "PLATFORM_UNSUPPORTED",
    "TARGET_REQUIRED",
    "LOCAL_EDITS",
    "UNMANAGED_TARGET",
    "TARGET_LOCKED",
    "INVALID_URL",
    "METHOD_UNSUPPORTED",
    "CREDENTIAL_INPUT_REJECTED",
    "ORIGIN_NOT_ALLOWED",
    "CONTAINER_NOT_FOUND",
    "CONTAINER_AMBIGUOUS",
    "SHOP_NOT_READY",
    "SHOP_VERIFICATION_FAILED",
    "BUSY",
    "REQUEST_FAILED",
    "NON_JSON_RESPONSE"
  ]
}

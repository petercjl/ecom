{
  "schemaVersion": 1,
  "package": "@petercjl/ecom-cli",
  "version": "0.1.1",
  "skills": [
    "ecom-cli"
  ],
  "commandContracts": {
    "help": {
      "options": {
        "--json": {
          "type": "boolean"
        }
      },
      "sideEffects": "none"
    },
    "version": {
      "options": {
        "--json": {
          "type": "boolean"
        }
      },
      "sideEffects": "none"
    },
    "capabilities": {
      "options": {
        "--json": {
          "type": "boolean"
        }
      },
      "sideEffects": "none"
    },
    "schema": {
      "options": {
        "--json": {
          "type": "boolean"
        }
      },
      "sideEffects": "none"
    },
    "doctor": {
      "options": {
        "--json": {
          "type": "boolean"
        },
        "--profile": {
          "type": "string"
        },
        "--instance": {
          "type": "string"
        }
      },
      "sideEffects": "none"
    },
    "containers list": {
      "options": {
        "--json": {
          "type": "boolean"
        },
        "--profile": {
          "type": "string"
        },
        "--instance": {
          "type": "string"
        }
      },
      "sideEffects": "local-write",
      "authorization": "Read container IDs and names; authenticated local request and throttled update cache only"
    },
    "skill source": {
      "options": {
        "--json": {
          "type": "boolean"
        },
        "--name": {
          "type": "string"
        }
      },
      "sideEffects": "none"
    },
    "skill status": {
      "options": {
        "--json": {
          "type": "boolean"
        },
        "--agent": {
          "type": "string"
        },
        "--target": {
          "type": "string"
        },
        "--name": {
          "type": "string"
        }
      },
      "sideEffects": "none"
    },
    "skill install": {
      "options": {
        "--json": {
          "type": "boolean"
        },
        "--agent": {
          "type": "string"
        },
        "--target": {
          "type": "string"
        },
        "--name": {
          "type": "string"
        }
      },
      "sideEffects": "local-write"
    },
    "skill update": {
      "options": {
        "--json": {
          "type": "boolean"
        },
        "--agent": {
          "type": "string"
        },
        "--target": {
          "type": "string"
        },
        "--name": {
          "type": "string"
        }
      },
      "sideEffects": "local-write"
    },
    "update check": {
      "options": {
        "--json": {
          "type": "boolean"
        }
      },
      "sideEffects": "none"
    },
    "update install": {
      "options": {
        "--json": {
          "type": "boolean"
        },
        "--agent": {
          "type": "string"
        },
        "--target": {
          "type": "string"
        },
        "--name": {
          "type": "string"
        },
        "--version": {
          "type": "string"
        },
        "--yes": {
          "type": "boolean"
        }
      },
      "sideEffects": "package-and-skill-update"
    }
  },
  "transport": {
    "kind": "private-local-mailbox",
    "protocolVersion": 1,
    "debuggingRequired": false,
    "platforms": {
      "macos": "implemented",
      "windows": "unsupported"
    }
  },
  "discoveryContract": {
    "schemaVersion": 1,
    "commandsField": "commandContracts",
    "entryPoints": [
      {
        "argv": [
          "capabilities",
          "--json"
        ],
        "result": "manifest"
      }
    ],
    "version": {
      "command": "version",
      "argv": [
        "version",
        "--json"
      ],
      "fields": {
        "package": {
          "field": "package",
          "type": "string"
        },
        "version": {
          "field": "version",
          "type": "string"
        }
      }
    },
    "skillCollection": {
      "namesField": "skills",
      "default": "ecom-cli",
      "selector": {
        "option": "--name",
        "type": "string"
      },
      "enumeration": {
        "argv": [
          "skill",
          "source",
          "--json"
        ],
        "itemsField": "items",
        "completeField": "complete"
      },
      "namedSource": [
        "skill",
        "source",
        "--name",
        "{skill}",
        "--json"
      ]
    }
  },
  "maintenanceContract": {
    "schemaVersion": 1,
    "agentEligibility": "valid-name-with-generic-fallback",
    "hostDiscoveryAuthority": "host",
    "targetOptions": {
      "--target": {
        "kind": "skill-directory"
      }
    },
    "source": {
      "name": {
        "field": "name",
        "type": "string"
      },
      "package": {
        "field": "package",
        "type": "string"
      },
      "version": {
        "field": "version",
        "type": "string"
      },
      "path": {
        "field": "path",
        "type": "string"
      }
    },
    "status": {
      "name": {
        "field": "name",
        "type": "string"
      },
      "package": {
        "field": "package",
        "type": "string"
      },
      "version": {
        "field": "version",
        "type": "string"
      },
      "target": {
        "field": "target",
        "type": "string"
      },
      "installed": {
        "field": "installed",
        "type": "boolean"
      },
      "managed": {
        "field": "managed",
        "type": "boolean"
      },
      "current": {
        "field": "current",
        "type": "boolean"
      },
      "edited": {
        "field": "edited",
        "type": "boolean"
      },
      "verification": {
        "field": "verification",
        "type": "object"
      },
      "recovery": {
        "field": "recovery",
        "type": "object"
      }
    }
  },
  "installationLifecycle": {
    "skillRequired": true,
    "updateRequiresSkillSync": true,
    "required_components": [
      "cli",
      "skill"
    ],
    "agentNeutral": true,
    "targetRequired": true,
    "hostRegistrationRequired": true,
    "installationMode": "copy",
    "sharedLinksAllowed": false,
    "isolatedRuntimeRequired": true,
    "installGuide": "INSTALL.md",
    "updateGuide": "UPDATE.md",
    "install": "Resolve current Agent exact Skill target; run skill install --agent NAME --target PATH; load Skill through host discovery.",
    "update": "Run selected Skill runtime update install --agent NAME --target PATH --yes; verify returned activated entry and refresh host discovery.",
    "verification": "Verify CLI and Skill versions, managed hashes and current=true; host loads installed SKILL.md independently."
  },
  "automaticUpdates": {
    "enabledByDefault": true,
    "intervalHours": 24,
    "timeoutMs": 1500,
    "trigger": "containers list task entry",
    "configuration": "Stable latest channel; detection only. Explicit update activates only the selected target runtime and Skill together.",
    "disable": "ECOM_CLI_UPDATE_CHECK=0",
    "recovery": "Offline checks retain installed runtime; local edit/ownership conflicts stop replacement; prior target kept as backup. Use recorded candidate and inspect target status before retrying.",
    "defaultMode": "notify"
  },
  "compatibility": {
    "agents": "Any Agent with terminal, Node.js and Skill discovery capabilities; generic adapter",
    "macos": "Runtime validation pending",
    "windows": "Package mechanics only; browser transport unsupported",
    "historicalUpdater": "First release; registry package absent; no prior updater exists"
  },
  "errors": [
    "INSTANCE_NOT_RUNNING",
    "INSTANCE_AMBIGUOUS",
    "INSTANCE_CHANGED",
    "UNSAFE_ENDPOINT",
    "OPERATION_TIMEOUT",
    "PROTOCOL_MISMATCH",
    "PLATFORM_UNSUPPORTED",
    "TARGET_REQUIRED",
    "LOCAL_EDITS",
    "UNMANAGED_TARGET",
    "TARGET_LOCKED"
  ]
}
